  notes         String?            @db.Text
  paidAt        DateTime?          @map("paid_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  roomOwner User @relation(fields: [roomOwnerId], references: [id], onDelete: Cascade)

  @@unique([periodId, agencyUserId, roomOwnerId])
  @@index([agencyUserId, periodId])
  @@map("agency_weekly_distributions")
}

model BonusClaim {
