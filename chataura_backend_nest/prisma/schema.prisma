model AgencyAffiliation {
  id           BigInt                   @id @default(autoincrement())
  agencyUserId BigInt                   @map("agency_user_id")
  roomOwnerId  BigInt                   @map("room_owner_id")
  roomId       String?                  @map("room_id") @db.Uuid
  status       AgencyAffiliationStatus  @default(pending)
  joinedAt     DateTime?                @map("joined_at") @db.Timestamptz(6)
  leftAt       DateTime?                @map("left_at") @db.Timestamptz(6)
  cooldownUntil DateTime?               @map("cooldown_until") @db.Timestamptz(6)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency    User  @relation("AgencyOwner", fields: [agencyUserId], references: [id], onDelete: Cascade)
  roomOwner User  @relation("AgencyMember", fields: [roomOwnerId], references: [id], onDelete: Cascade)
  room      Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([agencyUserId, status])
  @@index([roomOwnerId, status])
  @@map("agency_affiliations")
}

model AgencyWeeklyDistribution {
