model Conversation {
  id        BigInt   @id @default(autoincrement())
  type      String   @default("private") @db.VarChar(16)
  name      String?  @db.VarChar(255)
  imageUrl  String?  @map("image_url") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  participants ConversationParticipant[]
  messages     Message[]
  starSessions StarChatSession[]

  @@map("conversations")
}

model ConversationParticipant {
  id         BigInt    @id @default(autoincrement())
  conversationId BigInt @map("conversation_id")
  userId     BigInt    @map("user_id")
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             BigInt   @id @default(autoincrement())
  conversationId BigInt   @map("conversation_id")
  senderId       BigInt   @map("sender_id")
  messageType    String   @default("text") @map("message_type") @db.VarChar(32)
  messageText    String?  @map("message_text") @db.Text
  messageMedia   String?  @map("message_media") @db.Text
  giftId         BigInt?  @map("gift_id")
  stickerId      BigInt?  @map("sticker_id")
  status         String   @default("sent") @db.VarChar(16)
  clientUuid     String?  @map("client_uuid") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model StarChatSession {
  id                 BigInt         @id @default(autoincrement())
  conversationId     BigInt         @map("conversation_id")
  payerId            BigInt         @map("payer_id")
  starUserId         BigInt         @map("star_user_id")
  status             StarChatStatus @default(active)
  startedAt          DateTime       @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt            DateTime?      @map("ended_at") @db.Timestamptz(6)
  payerHeartbeatAt   DateTime?      @map("payer_heartbeat_at") @db.Timestamptz(6)
  pricePerMin        Int            @map("price_per_min")
  commissionPercent  Decimal        @map("commission_percent") @db.Decimal(8, 2)
  coinsCharged       BigInt         @default(0) @map("coins_charged")
  gemsCredited       BigInt         @default(0) @map("gems_credited")
  endReason          String?        @map("end_reason") @db.VarChar(64)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  payer        User         @relation("StarChatPayer", fields: [payerId], references: [id])
  star         User         @relation("StarChatStar", fields: [starUserId], references: [id])

  @@index([payerId, status])
  @@index([conversationId, status])
  @@map("star_chat_sessions")
}

enum MediaKind {
  post
  reel
}

enum AgencyAffiliationStatus {
  pending
  accepted
  rejected
  left
}

enum AgencyWeeklyStatus {
  pending
  approved
  rejected
  paid
}

model MediaItem {
  id               BigInt    @id @default(autoincrement())
  userId           BigInt    @map("user_id")
  kind             MediaKind
  mediaType        String    @map("media_type") @db.VarChar(16)
  fileUrl          String    @map("file_url") @db.Text
  thumbnailUrl     String?   @map("thumbnail_url") @db.Text
  caption          String?   @db.Text
  musicUrl         String?   @map("music_url") @db.Text
  effectName       String?   @map("effect_name") @db.VarChar(128)
  duration         Int?
  aspectRatio      String?   @map("aspect_ratio") @db.VarChar(16)
  isCameraRecorded Boolean   @default(false) @map("is_camera_recorded")
  likesCount       Int       @default(0) @map("likes_count")
  commentsCount    Int       @default(0) @map("comments_count")
  sharesCount      Int       @default(0) @map("shares_count")
  viewsCount       Int       @default(0) @map("views_count")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments MediaComment[]
  likes    MediaLike[]
  saves    MediaSave[]

  @@index([kind, createdAt])
  @@index([userId, kind])
  @@map("media_items")
}

model MediaComment {
  id        BigInt   @id @default(autoincrement())
  mediaId   BigInt   @map("media_id")
  userId    BigInt   @map("user_id")
  comment   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mediaId, createdAt])
  @@map("media_comments")
}

model MediaLike {
  id        BigInt   @id @default(autoincrement())
  mediaId   BigInt   @map("media_id")
  userId    BigInt   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mediaId, userId])
  @@map("media_likes")
}

model MediaSave {
  id        BigInt   @id @default(autoincrement())
  mediaId   BigInt   @map("media_id")
  userId    BigInt   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mediaId, userId])
  @@map("media_saves")
}

model MusicTrack {
