  @@map("countries")
}

model UserRoomPresenceSession {
  id                 BigInt    @id @default(autoincrement())
  userId             BigInt    @map("user_id")
  roomId             String    @map("room_id") @db.Uuid
  joinedAt           DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastHeartbeatAt    DateTime? @map("last_heartbeat_at") @db.Timestamptz(6)
  accumulatedSeconds Int       @default(0) @map("accumulated_seconds")
  isActive           Boolean   @default(true) @map("is_active")
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(6)
  closeReason        String?   @map("close_reason") @db.VarChar(64)
  finalSeconds       Int       @default(0) @map("final_seconds")
