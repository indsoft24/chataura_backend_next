# App
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_PASSWORD=chataura_dev
DATABASE_URL=postgresql://chataura_user:chataura_dev@localhost:5433/chataura_db?schema=public

# Redis (local Homebrew Redis on 6379; compose Redis maps to 6380 if used)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT — match Android/Laravel expires_in (3600s)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# Dev OTP: when SMTP is unset, OTP is logged and returned in data.dev_otp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@chataura.local
GOOGLE_CLIENT_ID=
SIGNUP_BONUS_COINS=50

# Agora RTC (Phase 4) — empty keys yield mock_agora_* tokens
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY=3600
CORS_ORIGIN=*

# Media (Phase 5) — empty GCS_BUCKET yields mock signed URLs + local /uploads
GCS_BUCKET=
PUBLIC_BASE_URL=http://localhost:3000
