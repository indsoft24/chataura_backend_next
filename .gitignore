dist/
build/
.next/
out/
*.tsbuildinfo

# Dependencies
node_modules/
/.pnp
.pnp.js

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment Variables (strictly protect credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!*/.env.example

# OS Files
.DS_Store
Thumbs.db
*.pem

# Testing & Coverage
coverage/
.nyc_output/

# IDEs & Editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
